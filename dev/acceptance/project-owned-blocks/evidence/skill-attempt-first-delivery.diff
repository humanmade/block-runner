+import { readFile } from 'node:fs/promises';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { describe, expect, it } from 'vitest';
+import { realize } from '../../src/index.js';
+
+const ROOT = path.resolve( path.dirname( fileURLToPath( import.meta.url ) ), '..', 'acceptance', 'project-owned-blocks' );
+
+async function source( ...segments: string[] ): Promise<string> {
+	return readFile( path.join( ROOT, ...segments ), 'utf8' );
+}
+
+describe( 'project-owned dynamic block source contract', () => {
+	it( 'keeps custom hero controls and attachment-derived server rendering in the consumer', async () => {
+		const [ editor, renderer ] = await Promise.all( [ source( 'dynamic-hero', 'index.js' ), source( 'dynamic-hero', 'render.php' ) ] );
+
+		expect( editor ).toContain( 'MediaUpload' );
+		expect( editor ).toContain( 'FocalPointPicker' );
+		expect( editor ).toContain( 'RichText' );
+		expect( editor ).toContain( 'Title level' );
+		expect( editor ).toContain( 'URLInputButton' );
+		expect( editor ).toContain( 'save: () => null' );
+		expect( renderer ).toContain( 'wp_get_attachment_image' );
+		expect( renderer ).toContain( "'fetchpriority' => 'high'" );
+		expect( renderer ).toContain( "'loading'       => false" );
+		expect( renderer ).toContain( 'wp_kses_post' );
+		expect( renderer ).toContain( 'Choose a featured image' );
+	} );
+
+	it( 'uses Block Runner output as parsed, saved native resource-list children', async () => {
+		const [ editor, renderer ] = await Promise.all( [ source( 'resource-list', 'index.js' ), source( 'resource-list', 'render.php' ) ] );
+		const report = await realize( JSON.stringify( {
+			blocks: [
+				{ block: 'core/heading', text: 'Resources', level: 2 },
+				{ block: 'core/paragraph', text: 'Browse our latest resources.' },
+			],
+		} ) );
+
+		expect( report.ok ).toBe( true );
+		expect( report.output ).toContain( '<!-- wp:heading -->' );
+		expect( editor ).toContain( 'realize( JSON.stringify( RESOURCES_INTENT ) )' );
+		expect( editor ).toContain( 'return parse( report.output );' );
+		expect( editor ).toContain( 'replaceInnerBlocks( clientId, blocks, false )' );
+		expect( editor ).toContain( '<InnerBlocks.Content />' );
+		expect( renderer ).toContain( 'wp_kses_post( $content )' );
+		expect( renderer ).toContain( "'post_status'    => 'publish'" );
+		expect( renderer ).toContain( "'category_name'" );
+	} );
+} );
