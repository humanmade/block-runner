@@ -0,0 +1,50 @@
+import { registerBlockType } from '@wordpress/blocks';
+import { useBlockProps, InspectorControls, MediaUpload, MediaUploadCheck, RichText, URLInputButton } from '@wordpress/block-editor';
+import { Button, FocalPointPicker, Notice, PanelBody, SelectControl, ToggleControl } from '@wordpress/components';
+import metadata from './block.json';
+
+function DynamicHeroEdit( { attributes, setAttributes } ) {
+	const { focalPoint, linkTarget, linkUrl, mediaId, title, titleLevel } = attributes;
+	const TagName = `h${ titleLevel }`;
+
+	return (
+		<div { ...useBlockProps() }>
+			<InspectorControls>
+				<PanelBody title="Hero settings">
+					<MediaUploadCheck>
+						<MediaUpload
+							allowedTypes={ [ 'image' ] }
+							value={ mediaId }
+							onSelect={ ( media ) => setAttributes( { mediaId: media.id } ) }
+							render={ ( { open } ) => <Button onClick={ open } variant="secondary">Choose featured image</Button> }
+						/>
+					</MediaUploadCheck>
+					<FocalPointPicker
+						label="Image focal point"
+						value={ focalPoint }
+						onChange={ ( nextFocalPoint ) => setAttributes( { focalPoint: nextFocalPoint } ) }
+					/>
+					<SelectControl
+						label="Title level"
+						value={ titleLevel }
+						options={ [ 1, 2, 3, 4, 5, 6 ].map( ( level ) => ( { label: `H${ level }`, value: level } ) ) }
+						onChange={ ( level ) => setAttributes( { titleLevel: Number( level ) } ) }
+					/>
+					<URLInputButton url={ linkUrl } onChange={ ( nextUrl ) => setAttributes( { linkUrl: nextUrl } ) } />
+					<ToggleControl
+						label="Open link in a new tab"
+						checked={ linkTarget }
+						onChange={ ( nextTarget ) => setAttributes( { linkTarget: nextTarget } ) }
+					/>
+				</PanelBody>
+			</InspectorControls>
+			<Notice status="info" isDismissible={ false }>The featured image uses responsive attachment markup on the front end.</Notice>
+			<RichText tagName={ TagName } value={ title } onChange={ ( nextTitle ) => setAttributes( { title: nextTitle } ) } placeholder="Hero title" />
+		</div>
+	);
+}
+
+registerBlockType( metadata.name, {
+	edit: DynamicHeroEdit,
+	save: () => null,
+} );
diff --git a/dev/acceptance/project-owned-blocks/dynamic-hero/render.php b/dev/acceptance/project-owned-blocks/dynamic-hero/render.php
new file mode 100644
index 0000000..61cbf8f
--- /dev/null
+++ b/dev/acceptance/project-owned-blocks/dynamic-hero/render.php
@@ -0,0 +1,39 @@
+<?php
+/**
+ * Server render for the test-owned dynamic hero.
+ *
+ * @var array<string, mixed> $attributes
+ */
+
+$media_id = isset( $attributes['mediaId'] ) ? absint( $attributes['mediaId'] ) : 0;
+$focal_point = isset( $attributes['focalPoint'] ) && is_array( $attributes['focalPoint'] ) ? $attributes['focalPoint'] : array();
+$focal_x = isset( $focal_point['x'] ) ? min( 1, max( 0, (float) $focal_point['x'] ) ) : 0.5;
+$focal_y = isset( $focal_point['y'] ) ? min( 1, max( 0, (float) $focal_point['y'] ) ) : 0.5;
+$level = isset( $attributes['titleLevel'] ) ? absint( $attributes['titleLevel'] ) : 1;
+$level = in_array( $level, array( 1, 2, 3, 4, 5, 6 ), true ) ? $level : 1;
+$title = isset( $attributes['title'] ) ? wp_kses_post( $attributes['title'] ) : '';
+$link_url = isset( $attributes['linkUrl'] ) ? esc_url( $attributes['linkUrl'] ) : '';
+$link_target = ! empty( $attributes['linkTarget'] ) ? ' target="_blank" rel="noopener noreferrer"' : '';
+$image = $media_id ? wp_get_attachment_image(
+	$media_id,
+	'full',
+	false,
+	array(
+		'class'         => 'wp-block-example-dynamic-hero__image',
+		'loading'       => false,
+		'fetchpriority' => 'high',
+		'decoding'      => 'async',
+		'style'         => sprintf( 'object-position: %.2f%% %.2f%%', $focal_x * 100, $focal_y * 100 ),
+	)
+) : '';
+?>
+<section <?php echo get_block_wrapper_attributes(); ?>>
+	<?php if ( $image ) : ?>
+		<?php if ( $link_url ) : ?><a href="<?php echo $link_url; ?>"<?php echo $link_target; ?>><?php endif; ?>
+		<?php echo wp_kses_post( $image ); ?>
+		<?php if ( $link_url ) : ?></a><?php endif; ?>
+	<?php else : ?>
+		<p class="wp-block-example-dynamic-hero__helper">Choose a featured image to complete this hero.</p>
+	<?php endif; ?>
+	<?php if ( $title ) : ?><h<?php echo esc_attr( (string) $level ); ?> class="wp-block-example-dynamic-hero__title"><?php echo $title; ?></h<?php echo esc_attr( (string) $level ); ?>><?php endif; ?>
+</section>
