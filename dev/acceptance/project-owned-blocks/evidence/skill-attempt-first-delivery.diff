+import { registerBlockType, parse } from '@wordpress/blocks';
+import { InnerBlocks, InspectorControls, useBlockProps } from '@wordpress/block-editor';
+import { useDispatch, useSelect } from '@wordpress/data';
+import { PanelBody, RangeControl, TextControl } from '@wordpress/components';
+import { useEffect } from '@wordpress/element';
+import { realize } from 'block-runner';
+import metadata from './block.json';
+
+export const RESOURCES_INTENT = {
+	blocks: [
+		{ block: 'core/heading', text: 'Resources', level: 2 },
+		{ block: 'core/paragraph', text: 'Browse our latest resources.' },
+	],
+};
+
+export async function createInitialResourcesBlocks() {
+	const report = await realize( JSON.stringify( RESOURCES_INTENT ) );
+	if ( ! report.ok || ! report.output ) {
+		throw new Error( 'Block Runner could not assemble the initial resource content.' );
+	}
+
+	return parse( report.output );
+}
+
+function ResourceListEdit( { attributes, clientId, setAttributes } ) {
+	const { replaceInnerBlocks } = useDispatch( 'core/block-editor' );
+	const hasInnerBlocks = useSelect(
+		( select ) => select( 'core/block-editor' ).getBlock( clientId )?.innerBlocks.length > 0,
+		[ clientId ]
+	);
+
+	useEffect( () => {
+		if ( hasInnerBlocks ) {
+			return undefined;
+		}
+
+		let active = true;
+		createInitialResourcesBlocks().then( ( blocks ) => {
+			if ( active ) {
+				replaceInnerBlocks( clientId, blocks, false );
+			}
+		} );
+		return () => {
+			active = false;
+		};
+	}, [ clientId, hasInnerBlocks, replaceInnerBlocks ] );
+
+	return (
+		<div { ...useBlockProps() }>
+			<InspectorControls>
+				<PanelBody title="Resource query">
+					<TextControl label="Category slug" value={ attributes.category } onChange={ ( category ) => setAttributes( { category } ) } />
+					<RangeControl label="Resources to show" value={ attributes.limit } onChange={ ( limit ) => setAttributes( { limit } ) } min={ 1 } max={ 12 } />
+				</PanelBody>
+			</InspectorControls>
+			<InnerBlocks />
+		</div>
+	);
+}
+
+registerBlockType( metadata.name, {
+	edit: ResourceListEdit,
+	save: () => <InnerBlocks.Content />,
+} );
diff --git a/dev/acceptance/project-owned-blocks/resource-list/render.php b/dev/acceptance/project-owned-blocks/resource-list/render.php
new file mode 100644
index 0000000..0ce82a5
--- /dev/null
+++ b/dev/acceptance/project-owned-blocks/resource-list/render.php
@@ -0,0 +1,34 @@
+<?php
+/**
+ * Server render for the test-owned combined resource list.
+ *
+ * @var array<string, mixed> $attributes
+ * @var string $content
+ */
+
+$category = isset( $attributes['category'] ) ? sanitize_title( $attributes['category'] ) : '';
+$limit = isset( $attributes['limit'] ) ? absint( $attributes['limit'] ) : 3;
+$limit = min( 12, max( 1, $limit ) );
+$query_args = array(
+	'post_status'    => 'publish',
+	'posts_per_page' => $limit,
+	'no_found_rows'  => true,
+);
+
+if ( $category ) {
+	$query_args['category_name'] = $category;
+}
+
+$resources = new WP_Query( $query_args );
+?>
+<section <?php echo get_block_wrapper_attributes(); ?>>
+	<?php echo wp_kses_post( $content ); ?>
+	<?php if ( $resources->have_posts() ) : ?>
+		<ul class="wp-block-example-resource-list__results">
+			<?php while ( $resources->have_posts() ) : $resources->the_post(); ?>
+				<li><a href="<?php echo esc_url( get_permalink() ); ?>"><?php echo esc_html( get_the_title() ); ?></a></li>
+			<?php endwhile; ?>
+		</ul>
+	<?php endif; ?>
+</section>
+<?php wp_reset_postdata(); ?>
diff --git a/dev/test/project-owned-blocks.source-contract.test.ts b/dev/test/project-owned-blocks.source-contract.test.ts
